# Database Configuration
DB_NAME=medical_records
DB_USER=medapp
# IMPORTANT: Password special character handling
# - Problematic characters:
#   - $ triggers variable expansion (always escape as $$, e.g., pass$$word -> pass$word)
#   - # starts a comment if unquoted (wrap in quotes: DB_PASSWORD="my#pass")
# - Safe special characters (no escaping needed): @ % ^ & * ( ) - _ . !
# - Example with special chars: DB_PASSWORD="P@ss#w0rd$$5%^&*()"
# - Example simple password: MySecure-Pass_2024.db
DB_PASSWORD=your-secure-password-here

# App Configuration
APP_PORT=8005
SECRET_KEY=replace-with-a-random-32-char-value  # Required for persistent JWTs; ephemeral key generated if unset
DEBUG=false
ENABLE_API_DOCS=false  # Set to true to expose Swagger docs
LOG_LEVEL=INFO
TZ=America/New_York

# Integration URL SSRF protection
# Allows Paperless/Papra URLs on private/internal addresses (localhost, 10.x,
# 172.16-31.x, 192.168.x) by default, for self-hosted setups. Set to false on
# internet-exposed / multi-user instances to restrict integrations to public
# addresses. Link-local / cloud-metadata (169.254.x) is always blocked.
# ALLOW_PRIVATE_INTEGRATION_URLS=true

# SSL Configuration
ENABLE_SSL=false

# Default Admin Password Configuration
# Set custom password for the default admin user (defaults to admin123 if not set)
## ADMIN_DEFAULT_PASSWORD=your-custom-admin-password

# GitHub SSO Configuration
SSO_ENABLED=true
SSO_PROVIDER_TYPE=github
SSO_CLIENT_ID=your-github-client-id
SSO_CLIENT_SECRET=your-github-client-secret
SSO_REDIRECT_URI=http://localhost:8005/auth/sso/callback
SSO_ALLOWED_DOMAINS=[]

# SSO-only mode and IdP auto-redirect. Both default to false; both require
# SSO_ENABLED=true. The container refuses to start if either is set without it,
# rather than booting into an instance nobody can sign in to.
#
# SSO_ONLY_MODE=true     The server refuses password login and password
#                        registration (403). NOTE: in this release the login
#                        page still shows the password form - the server just
#                        refuses it. Hiding the form ships with the frontend
#                        half of this feature.
# SSO_AUTO_REDIRECT=true Unauthenticated visitors are sent straight to the
#                        identity provider, with /login?local=1 to reach the
#                        login page directly. NOTE: no effect yet in this
#                        release; it ships with the same frontend half.
#
# Accepted values are true/false (also 1/0, yes/no, on/off), and these two are
# checked strictly: anything else fails the boot with an error naming the
# variable, rather than being read as false. Note that a compose env file does
# NOT strip inline comments, so `SSO_ONLY_MODE=true # my note` is the whole
# string - put comments on their own line.
#
# To recover if the identity provider is unreachable: set SSO_ONLY_MODE=false,
# restart, and sign in locally. There is deliberately no in-app toggle for these.
#SSO_ONLY_MODE=false
#SSO_AUTO_REDIRECT=false

# Optional UID/GID for bind mounts
#PUID=1000
#PGID=1000

# --- Docker Secrets (_FILE pattern) ---
# Instead of setting a secret directly as an env var, you can point to a file
# containing the secret. Set VAR_FILE=/path/to/file and remove the plain VAR.
# Direct VAR always takes precedence if both are set.
#
# Supported variables:
#   DB_USER_FILE, DB_PASSWORD_FILE, DATABASE_URL_FILE, SECRET_KEY_FILE,
#   ADMIN_DEFAULT_PASSWORD_FILE, SSO_CLIENT_ID_FILE, SSO_CLIENT_SECRET_FILE,
#   PAPERLESS_SALT_FILE, NOTIFICATION_ENCRYPTION_SALT_FILE
#
# Example (Docker Swarm / Compose secrets):
#   DB_PASSWORD_FILE=/run/secrets/db_password
#   SECRET_KEY_FILE=/run/secrets/secret_key